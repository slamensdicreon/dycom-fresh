# Copy to .env.local. Leave everything blank to run on local content (content/), which is the
# default until Dycom's SitecoreAI environment exists. Filling SITECORE_EDGE_CONTEXT_ID switches
# the app to Experience Edge — see README "Connecting SitecoreAI".

# --- Site -----------------------------------------------------------------------------------
# Sitecore site name and default language. Must match the site in Sitecore (and content/sites.json).
NEXT_PUBLIC_DEFAULT_SITE_NAME=dycom
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
# Absolute origin used for metadata (canonical/OG URLs).
PUBLIC_URL=

# --- Experience Edge (SitecoreAI) ---------------------------------------------------------------
# Server-side context id. Setting this turns local content mode off.
SITECORE_EDGE_CONTEXT_ID=
# Client-side context id (Events/Analytics SDK, Pages styles).
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=
# Optional custom Edge hostname.
NEXT_PUBLIC_SITECORE_EDGE_PLATFORM_HOSTNAME=

# --- Local CM (Docker containers), instead of Edge ---------------------------------------------
# SITECORE_API_HOST=
# SITECORE_API_KEY=

# --- Editing (Sitecore Pages) ---------------------------------------------------------------
# Secret shared with Sitecore to secure /api/editing/* (add the editing routes when connecting).
SITECORE_EDITING_SECRET=

# --- Personalize ----------------------------------------------------------------------------
NEXT_PUBLIC_PERSONALIZE_SCOPE=
PERSONALIZE_MIDDLEWARE_CDP_TIMEOUT=
PERSONALIZE_MIDDLEWARE_EDGE_TIMEOUT=

# --- Design Library ---------------------------------------------------------------------------
SITECORE_AUTH_CLIENT_ID=
SITECORE_AUTH_CLIENT_SECRET=
SITECORE_RENDERINGHOST_NAME=

# Debug logging for the Content SDK, e.g. DEBUG=content-sdk:*
#DEBUG=
